#!/usr/bin/env ruby
require "securerandom"
require "yaml"
require "net/http"

# rubocop:disable ThreadSafety/DirChdir -- Isolated CLI process before Rails loads.
Dir.chdir File.expand_path("..", __dir__) do
  case ARGV
  when [ "setup" ]
    path = "config/operations.local.yml"
    if File.exist?(path)
      puts "Local access already configured: #{path}"
    else
      File.open(path, File::WRONLY | File::CREAT | File::EXCL, 0o600) do |file|
        file.write({ "username" => "starterapp", "password" => SecureRandom.hex(32), "metrics_token" => SecureRandom.hex(32) }.to_yaml)
      end
      puts "Health credentials and metrics token: #{path}. Sign in to /admin with an administrator account."
    end
  when [ "monitoring" ]
    system("bin/rails", "runner", "script/prepare_monitoring.rb", exception: true)
    system("docker", "compose", "--profile", "monitoring", "up", "--detach", "--wait", "--wait-timeout", "60", "prometheus", "grafana", "loki", "alloy", exception: true)
    # Loki accepts requests after its ring recovers.
    uri = URI("http://127.0.0.1:3001/api/datasources/proxy/uid/loki/ready")
    deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + 60
    loop do
      response = Net::HTTP.start(uri.host, uri.port, open_timeout: 2, read_timeout: 3) { |http| http.get(uri.request_uri) }
      break if response.is_a?(Net::HTTPSuccess)
      abort "Loki is not ready: HTTP #{response.code}. Check docker compose logs loki alloy." unless response.code == "503"
      abort "Loki did not start within 60 seconds. Check docker compose logs loki alloy." if Process.clock_gettime(Process::CLOCK_MONOTONIC) >= deadline
      sleep 2
    end
    puts "Monitoring is ready: http://localhost:3001"
  when [ "queue" ]
    exec "bin/rails", "runner", "puts JSON.pretty_generate(Operations::QueueSnapshot.capture)"
  else
    abort "Usage: bin/ops setup | queue | monitoring"
  end
end

# rubocop:enable ThreadSafety/DirChdir
