#!/usr/bin/env ruby
require "fileutils"
require "json"

# rubocop:disable ThreadSafety/DirChdir -- Separate CLI process; set the working directory before application startup.
Dir.chdir File.expand_path("..", __dir__) do
  abort "Run bin/configure first; see docs/template.md" unless JSON.parse(File.read("config/template.json")).fetch("configured")
  abort "Options: --skip-server, --skip-docker" unless (ARGV - %w[--skip-server --skip-docker]).empty?
  system("bundle check") || system("bundle install", exception: true)
  system("npm", "ci", exception: true)
  system("npm", "run", "build:agents", exception: true)
  system("bin/lefthook", "install", exception: true)
  unless ARGV.include?("--skip-docker")
    system("docker", "compose", "up", "--detach", "--wait", "postgres", exception: true)
  end
  system("bin/ops", "setup", exception: true)
  system("bin/cable", "setup", exception: true)
  system("bin/images", "setup", exception: true)
  system("bin/rails", "db:prepare", exception: true)
  system({ "RAILS_ENV" => "test" }, "bin/rails", "db:prepare", exception: true)
  system("bin/rails", "tailwindcss:build", exception: true)
  system("bin/native", "check", exception: true)
  exec "bin/dev" unless ARGV.include?("--skip-server")
end
# rubocop:enable ThreadSafety/DirChdir
