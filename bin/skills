#!/usr/bin/env ruby
require "json"
require "yaml"
require "digest"

abort "Usage: bin/skills check" unless ARGV == [ "check" ]
root = File.expand_path("..", __dir__)
manifest = JSON.parse(File.read(File.join(root, "config/agent_skills.json")))
entries = manifest.fetch("skills")
project_names = manifest.fetch("project_skills")
names = entries.map { |entry| entry.fetch("local_name") } + project_names
raise "Duplicate skill names" unless names.uniq == names
directories = Dir.children(File.join(root, ".agents/skills")).select { |name| File.directory?(File.join(root, ".agents/skills", name)) }
raise "The .agents/skills directory does not match the registry" unless directories.sort == names.sort
sources = entries.to_h { |entry| [ entry.fetch("local_name"), entry.fetch("name") ] }
entries.each do |entry|
  source = File.join(root, "vendor/agent-skills/evilmartians", entry.fetch("name"))
  actual = Dir.glob("**/*", base: source).select { |path| File.file?(File.join(source, path)) }.sort
  raise "Upstream file set changed: #{entry.fetch('name')}" unless actual == entry.fetch("files").keys.sort
  entry.fetch("files").each do |path, digest|
    raise "Upstream changed: #{path}" unless Digest::SHA256.file(File.join(source, path)).hexdigest == digest
  end
end
names.each do |name|
  path = File.join(root, ".agents/skills", name, "SKILL.md")
  content = File.read(path)
  header = content.match(/\A---\n(.*?)\n---\n/m) or raise "Missing frontmatter: #{path}"
  metadata = YAML.safe_load(header[1])
  raise "Invalid name: #{path}" unless metadata.fetch("name") == name
  raise "Empty description: #{path}" if metadata.fetch("description").strip.empty?
  details = metadata.fetch("metadata")
  raise "Invalid version: #{path}" unless /\A[1-9]\d*\z/.match?(details.fetch("version"))
  if project_names.include?(name)
    raise "Invalid origin: #{path}" unless details.fetch("origin") == "project"
  else
    raise "Missing source: #{path}" unless details.fetch("upstream") == sources.fetch(name)
  end
end
puts "Skills: #{entries.size} adaptations, #{project_names.size} project skills; structure and upstream SHA-256 verified"
