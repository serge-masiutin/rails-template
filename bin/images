#!/usr/bin/env ruby
require "securerandom"
require "yaml"

# rubocop:disable ThreadSafety/DirChdir -- The CLI sets cwd before starting processes.
Dir.chdir File.expand_path("..", __dir__) do
  case ARGV
  when [ "setup" ]
    path = "config/imgproxy.local.yml"
    unless File.exist?(path)
      File.open(path, File::WRONLY | File::CREAT | File::EXCL, 0o600) do |file|
        file.write({ "key" => SecureRandom.hex(32), "salt" => SecureRandom.hex(32) }.to_yaml)
      end
    end
    puts "Local imgproxy configured; keys are excluded from Git and Docker."
  when [ "start" ]
    local = YAML.safe_load_file("config/imgproxy.local.yml")
    %w[key salt].each do |name|
      ENV["IMGPROXY_#{name.upcase}"] ||= local.fetch(name)
      abort "Invalid IMGPROXY_#{name.upcase}" unless /\A[0-9a-fA-F]{64}\z/.match?(ENV.fetch("IMGPROXY_#{name.upcase}"))
    end
    exec "docker", "compose", "run", "--rm", "--no-deps", "--service-ports", "imgproxy"
  else
    abort "Usage: bin/images setup | start"
  end
end
# rubocop:enable ThreadSafety/DirChdir
