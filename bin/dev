#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
for tool in overmind tmux docker; do
  command -v "$tool" >/dev/null || { echo "Не найден $tool. Установите зависимости из Brewfile." >&2; exit 1; }
done
docker compose up --detach --wait postgres
bin/cable setup
bin/images setup
bin/ops setup
bin/ops monitoring
exec overmind start -f Procfile.dev "$@"
