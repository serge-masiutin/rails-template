<% content_for :title, t("admin.navigation.overview") %>
<div data-controller="live-region" data-live-region-url-value="<%= admin_root_path %>" data-live-region-live-value="<%= t("admin.live.live") %>" data-live-region-offline-value="<%= t("admin.live.offline") %>" data-live-region-paused-value="<%= t("admin.live.paused") %>" data-live-region-denied-value="<%= t("admin.live.denied") %>">
  <div class="admin-page-heading">
    <h1><%= t("admin.navigation.overview") %></h1>
    <%= render "admin/shared/live_status" %>
  </div>
  <turbo-frame id="operations-overview" data-live-region-target="content">
    <%= render "snapshot", health: @health %>
  </turbo-frame>
</div>
