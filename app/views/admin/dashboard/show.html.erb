<% content_for :title, t("admin.navigation.overview") %>
<div class="flex flex-wrap items-start justify-between gap-4">
  <div>
    <p class="text-sm text-muted"><%= Rails.env %> · Ruby <%= RUBY_VERSION %> · Rails <%= Rails.version %></p>
    <h1 class="mt-2 text-3xl font-semibold"><%= t("admin.dashboard.heading") %></h1>
    <p class="mt-3 text-sm text-muted"><%= t("admin.dashboard.snapshot", time: l(Time.current.utc, format: :snapshot)) %></p>
  </div>
  <%= link_to t("actions.refresh"), admin_root_path, class: "rounded-xl border border-line bg-surface px-4 py-3 text-sm", data: { turbo: false } %>
</div>
<% if @health.key?(:error) %>
  <%= render Ui::NoticeComponent.new(message: t("admin.dashboard.unavailable"), variant: :alert) %>
<% else %>
  <% queue = @health.fetch(:queue) %>
  <section class="space-y-4" aria-labelledby="workers-title">
    <h2 id="workers-title" class="text-xl font-semibold"><%= t("admin.dashboard.workers") %></h2>
    <%= render Ui::NoticeComponent.new(message: @health.fetch(:healthy) ? t("admin.dashboard.healthy") : t("admin.dashboard.unhealthy"), variant: @health.fetch(:healthy) ? :notice : :alert) %>
    <dl class="grid gap-4 sm:grid-cols-3">
      <% { "worker" => "Worker", "dispatcher" => "Dispatcher", "scheduler" => "Scheduler" }.each do |kind, label| %>
        <div class="rounded-xl border border-line bg-surface p-5">
          <dt class="text-sm text-muted"><%= label %></dt>
          <dd class="mt-2 text-3xl font-semibold"><%= queue.fetch(:processes).fetch(kind) %></dd>
        </div>
      <% end %>
    </dl>
    <p class="text-sm text-muted"><%= t("admin.dashboard.heartbeat_help") %></p>
  </section>
  <section class="space-y-4" aria-labelledby="queue-title">
    <h2 id="queue-title" class="text-xl font-semibold"><%= t("admin.dashboard.jobs") %></h2>
    <dl class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
      <% { ready: "Ready", scheduled: "Scheduled", claimed: "Claimed", blocked: "Blocked", failed: "Failed" }.each do |state, label| %>
        <div class="rounded-xl border border-line bg-surface p-4">
          <dt class="break-words text-sm text-muted"><%= label %></dt>
          <dd class="mt-2 text-3xl font-semibold <%= state == :failed && queue.fetch(:jobs).fetch(state).positive? ? "text-danger" : "text-ink" %>"><%= queue.fetch(:jobs).fetch(state) %></dd>
        </div>
      <% end %>
    </dl>
    <p class="text-sm"><%= t("admin.dashboard.oldest_ready", count: queue.fetch(:oldest_ready_age_seconds)) %></p>
    <%= link_to t("admin.dashboard.open_jobs"), mission_control_jobs_path, class: "inline-block py-3 text-accent underline", data: { turbo: false } %>
  </section>
<% end %>
<section class="grid gap-4 sm:grid-cols-2" aria-label="<%= t("admin.dashboard.diagnostics") %>">
  <%= link_to operations_agents_path, class: "block rounded-xl border border-line bg-surface p-6", data: { turbo: false } do %>
    <h2 class="font-semibold text-accent">AgentPrism →</h2>
    <p class="mt-3 text-sm text-muted"><%= t("admin.dashboard.agents") %></p>
  <% end %>
  <%= link_to admin_observability_path, class: "block rounded-xl border border-line bg-surface p-6" do %>
    <h2 class="font-semibold text-accent"><%= t("admin.dashboard.observability_link") %></h2>
    <p class="mt-3 text-sm text-muted"><%= t("admin.dashboard.observability") %></p>
  <% end %>
</section>
