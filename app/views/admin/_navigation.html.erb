<aside class="admin-navigation">
  <%= link_to main_app.admin_root_path, class: "admin-navigation__brand", data: { turbo: false } do %>
    <span class="admin-navigation__mark" aria-hidden="true"><%= t("app.name").first %></span><%= t("app.name") %>
  <% end %>
  <nav aria-label="<%= t("admin.navigation.label") %>">
    <% [[t("admin.navigation.overview"), main_app.admin_root_path], ["Mission Control", main_app.mission_control_jobs_path], ["AgentPrism", main_app.operations_agents_path], [t("admin.navigation.observability"), main_app.admin_observability_path]].each do |label, path| %>
      <%= link_to label, path, aria: { current: (path == main_app.admin_root_path ? request.path == path : request.path.start_with?(path)) ? "page" : nil }, data: { turbo: false } %>
    <% end %>
    <%= link_to t("admin.navigation.app"), main_app.root_path, class: "admin-navigation__app", data: { turbo: false } %>
  </nav>
  <% if Rails.env.development? %>
    <nav class="admin-navigation__development" aria-label="<%= t("admin.navigation.development") %>">
      <span class="admin-navigation__heading"><%= t("admin.navigation.development") %></span>
      <% [["Lookbook", "/lookbook"], [t("admin.navigation.mail_previews"), "/rails/mailers"], [t("admin.navigation.routes"), "/rails/info/routes"], ["Alloy", "http://localhost:12345"]].each do |label, path| %>
        <%= link_to "#{label} ↗", path, target: "_blank", rel: "noopener noreferrer", data: { turbo: false } %>
      <% end %>
    </nav>
  <% end %>
</aside>
