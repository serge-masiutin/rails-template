<header class="admin-navigation">
  <a class="admin-navigation__brand" href="<%= main_app.admin_root_path %>" data-turbo="false">StarterApp <span><%= t("admin.navigation.admin") %></span></a>
  <nav aria-label="<%= t("admin.navigation.label") %>">
    <%= link_to t("admin.navigation.overview"), main_app.admin_root_path, aria: { current: request.path == main_app.admin_root_path ? "page" : nil }, data: { turbo: false } %>
    <%= link_to "Mission Control", main_app.mission_control_jobs_path, aria: { current: request.path.start_with?(main_app.mission_control_jobs_path) ? "page" : nil }, data: { turbo: false } %>
    <%= link_to "AgentPrism", main_app.operations_agents_path, aria: { current: request.path == main_app.operations_agents_path ? "page" : nil }, data: { turbo: false } %>
    <%= link_to t("admin.navigation.observability"), main_app.admin_observability_path, aria: { current: request.path == main_app.admin_observability_path ? "page" : nil }, data: { turbo: false } %>
    <%= link_to t("admin.navigation.app"), main_app.root_path, data: { turbo: false } %>
  </nav>
</header>
