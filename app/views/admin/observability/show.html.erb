<% content_for :title, t("admin.observability.heading") %>
<h1 class="text-3xl font-semibold"><%= t("admin.observability.heading") %></h1>
<% if Rails.env.development? %>
  <p class="text-sm text-muted"><%= t("admin.observability.local_html") %></p>
<% end %>
<div class="grid gap-4 sm:grid-cols-2">
  <% { grafana_url: [ "Grafana", t("admin.observability.grafana_description") ], prometheus_url: [ "Prometheus", t("admin.observability.prometheus_description") ], logs_url: [ t("admin.observability.logs"), t("admin.observability.logs_description") ] }.each do |attribute, (title, description)| %>
    <section class="rounded-xl border border-line bg-surface p-6">
      <h2 class="text-xl font-semibold"><%= title %></h2>
      <p class="mt-3 text-sm text-muted"><%= description %></p>
      <% url = @operations.public_send(attribute) %>
      <% if url.present? %>
        <%= link_to t("admin.observability.open", service: title), url, class: "mt-4 inline-block py-3 text-accent underline", target: "_blank", rel: "noopener noreferrer" %>
        <p class="mt-2 text-sm text-muted"><%= t("admin.observability.external_service") %></p>
      <% else %>
        <p class="mt-4 text-sm font-medium"><%= t("admin.observability.not_configured") %></p>
        <p class="mt-2 break-words text-sm text-muted"><%= t("admin.observability.configure", variable: "OPERATIONS_#{attribute.to_s.upcase}") %></p>
      <% end %>
    </section>
  <% end %>
</div>
<section class="space-y-4 rounded-xl border border-line bg-surface p-6" aria-labelledby="logs-title">
  <h2 id="logs-title" class="text-xl font-semibold"><%= t("admin.observability.find_error") %></h2>
  <ol class="list-decimal space-y-3 pl-5 text-sm">
    <li><%= t("admin.observability.step_one") %></li>
    <li><%= t("admin.observability.step_two") %></li>
    <li><%= t("admin.observability.step_three") %></li>
  </ol>
  <p class="text-sm text-muted"><%= t("admin.observability.production_logs") %></p>
  <div class="overflow-x-auto rounded-lg bg-canvas p-4 text-sm">
    <pre><code>bin/kamal web-logs
bin/kamal job-logs
bin/kamal cable-logs
bin/kamal image-logs</code></pre>
  </div>
  <p class="text-sm text-muted"><%= t("admin.observability.local_search_html") %></p>
</section>
