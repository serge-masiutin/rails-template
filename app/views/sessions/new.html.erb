<% content_for :title, "Вход · StarterApp" %>
<section class="mx-auto max-w-md space-y-6">
  <h1 class="text-3xl font-semibold tracking-tight">Войти в StarterApp</h1>
  <p class="text-muted">Используйте свой рабочий аккаунт.</p>
  <%= form_with url: session_path, class: "space-y-5" do |form| %>
    <div>
      <%= form.label :email_address, "Email", class: "mb-2 block text-sm font-medium" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "w-full rounded-xl border border-line bg-surface px-4 py-3" %>
    </div>
    <div>
      <%= form.label :password, "Пароль", class: "mb-2 block text-sm font-medium" %>
      <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: "w-full rounded-xl border border-line bg-surface px-4 py-3" %>
    </div>
    <%= form.submit "Войти", class: "w-full cursor-pointer rounded-xl bg-accent px-5 py-3 font-medium text-white" %>
  <% end %>
  <div data-controller="disclosure">
    <button type="button" data-action="disclosure#toggle" data-disclosure-target="button" aria-expanded="false" aria-controls="login-help" class="text-sm font-medium text-accent">Нужна помощь со входом?</button>
    <div id="login-help" data-disclosure-target="content" hidden class="mt-3 text-sm">
      <%= link_to "Восстановить пароль", new_password_path, class: "text-accent underline" %>
    </div>
  </div>
</section>
