<% content_for :title, t("layout.page_title", title: t("passwords.edit.title"), app: t("app.name")) %>
<section class="mx-auto max-w-md space-y-6">
  <h1 class="text-3xl font-semibold"><%= t("passwords.edit.heading") %></h1>
  <% if @user.errors.any? %>
    <%= render Ui::NoticeComponent.new(message: @user.errors.full_messages.to_sentence, variant: :alert) %>
  <% end %>
  <%= form_with url: password_path(params[:token]), method: :put, class: "space-y-5" do |form| %>
    <%= render Ui::FieldComponent.new(form: form, attribute: :password, label: t("fields.password"), type: :password, required: true, minlength: 12, maxlength: 72, autocomplete: "new-password", error: @user.errors.full_messages_for(:password).to_sentence) %>
    <%= render Ui::FieldComponent.new(form: form, attribute: :password_confirmation, label: t("fields.password_confirmation"), type: :password, required: true, minlength: 12, maxlength: 72, autocomplete: "new-password", error: @user.errors.full_messages_for(:password_confirmation).to_sentence) %>
    <%= render Ui::SubmitComponent.new(form: form, label: t("actions.save_password")) %>
  <% end %>
</section>
