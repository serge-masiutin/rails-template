<!DOCTYPE html>
<html lang="<%= I18n.locale %>" dir="<%= t("layout.direction") %>">
  <head>
    <title><%= t("layout.admin_title", title: content_for(:title), app: t("app.name")) %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="turbo-cache-control" content="no-cache">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "admin_navigation", "data-turbo-track": "reload" %>
    <%= render "shared/typography" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="min-h-screen antialiased">
    <a href="#main" class="sr-only focus:not-sr-only"><%= t("layout.skip_content") %></a>
    <%= render "admin/navigation" %>
    <main id="main" class="mx-auto max-w-5xl space-y-8 px-6 py-8">
      <%= yield %>
    </main>
  </body>
</html>
