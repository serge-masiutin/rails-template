<!DOCTYPE html>
<html lang="<%= I18n.locale %>" dir="<%= t("layout.direction") %>">
  <head>
    <title><%= t("layout.components_title", app: t("app.name")) %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <meta name="action-cable-url" content="<%= realtime_url %>">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= render "shared/typography" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="min-h-screen p-6 antialiased">
    <%= yield %>
  </body>
</html>
