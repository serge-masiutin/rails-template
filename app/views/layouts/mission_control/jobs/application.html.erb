<%# mission_control-jobs-1.3.1: layout override for shared typography; review when upgrading the gem. %>
<!DOCTYPE html>
<html lang="<%= I18n.locale %>" dir="<%= t("layout.direction") %>">
<head>
  <title>Mission Control — <%= page_title %></title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="turbo-cache-control" content="no-cache">
    <meta name="action-cable-url" content="<%= realtime_url %>">
  <meta name="turbo-prefetch" content="false">

  <%= stylesheet_link_tag "mission_control/jobs/bulma.min" %>
  <%= stylesheet_link_tag "mission_control/jobs/application", "mission_control/jobs/forms", "mission_control/jobs/jobs", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags "application", importmap: MissionControl::Jobs.importmap %>
  <%= javascript_import_module_tag "admin_jobs" %>
  <%= render "shared/typography" %>
  <%= stylesheet_link_tag "admin_navigation" %>
</head>
<body class="admin-shell">
<%= render "admin/navigation" %>
    <%= render "admin/shared/stream" %>

<section class="section admin-main" lang="en" data-controller="live-region" data-live-region-url-value="<%= request.fullpath %>" data-live-region-live-value="<%= t("admin.live.live") %>" data-live-region-offline-value="<%= t("admin.live.offline") %>" data-live-region-paused-value="<%= t("admin.live.paused") %>" data-live-region-denied-value="<%= t("admin.live.denied") %>">
  <div class="admin-page-heading"><h1>Mission Control</h1><%= render "admin/shared/live_status" %></div>
  <turbo-frame id="jobs-content" target="_top" data-live-region-target="content">
  <div class="container">
    <%= render "layouts/mission_control/jobs/application_selection" if selectable_applications.any? || @application.servers.many? %>
    <%= render "layouts/mission_control/jobs/flash" %>
    <%= render "layouts/mission_control/jobs/navigation" %>
    <%= yield %>
  </div>
  </turbo-frame>
</section>

</body>
</html>
