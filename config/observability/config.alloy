logging {
  level = "warn"
  format = "json"
}

loki.source.file "rails" {
  targets = [{
    __path__ = "/var/log/app/development.jsonl",
    service_name = "starterapp",
    environment = "development",
  }]
  forward_to = [loki.process.rails.receiver]
}

loki.process "rails" {
  stage.json {
    expressions = { timestamp = "timestamp" }
  }
  stage.timestamp {
    source = "timestamp"
    format = "RFC3339Nano"
  }
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
