{
  "uid": "starterapp-logs",
  "title": "StarterApp Logs",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "links": [
    {
      "title": "Metrics",
      "type": "link",
      "url": "/d/starterapp",
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "search",
        "label": "Search / request_id / job_id",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Application and jobs",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 22
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"starterapp\"} |= ${search:doublequote} | json | line_format \"{{.name}} \u2014 {{.message}}\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    }
  ]
}
